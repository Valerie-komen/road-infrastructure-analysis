          { "color": { "solid": { "color": "#0b0b0b" } }, "fontSize": 26, "fontFamily": "Segoe UI Semibold" }
        ],
        "categoryLabels": [
          { "color": { "solid": { "color": "#898781" } }, "fontSize": 11 }
